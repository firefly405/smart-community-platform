# 复制本文件为 .env 并填入真实值，启动前通过 IDE/脚本注入环境变量
# 后端启动时需要以下环境变量（未设置则使用 application.yml 中的默认值）

# MySQL 数据库连接
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=smart_community
MYSQL_USERNAME=smartcommunity
MYSQL_PASSWORD=SmartCommunityDev2026

# JWT 密钥（生产环境必须修改为随机 256 位字符串）
JWT_SECRET=change-me-to-a-random-256-bit-secret

# AI 默认关闭；也可在「系统管理 -> AI配置」中填写并保存
AI_ENABLED=false
AI_API_URL=https://api.siliconflow.cn/v1
AI_PROVIDER_BASE_URL=https://api.siliconflow.cn
AI_API_KEY=your_api_key_here
AI_CHAT_MODEL=your_chat_model
AI_EMBEDDING_ENABLED=false
AI_EMBEDDING_MODEL=your_embedding_model

# 支付通道（mock=本地模拟非真实资金；real=真实通道，尚未对接会拒绝支付）
PAYMENT_MODE=mock
# 生产/预发若误配 mock，可再设 false 强制关闭模拟支付
PAYMENT_MOCK_ENABLED=true
# 模拟交易号前缀
PAYMENT_MOCK_PREFIX=MOCK
